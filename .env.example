# XAI-SDN Environment Configuration
# Copy this file to .env and fill in values

# ─── API ─────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_SECRET_KEY=changeme-generate-with-openssl-rand-hex-32
API_LOG_LEVEL=info

# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///data/alerts.db
# For PostgreSQL: postgresql+asyncpg://user:password@localhost:5432/xaisdn

# ─── Redis (optional — for alert streaming) ──────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── MLflow ──────────────────────────────────────────────────────────────────
MLFLOW_TRACKING_URI=mlruns
# For remote: MLFLOW_TRACKING_URI=http://localhost:5000

# ─── Dashboard ───────────────────────────────────────────────────────────────
DASHBOARD_API_URL=http://localhost:8000
DASHBOARD_PORT=8501

# ─── Monitoring ──────────────────────────────────────────────────────────────
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_PASSWORD=admin

# ─── SDN Controller ──────────────────────────────────────────────────────────
SDN_CONTROLLER_HOST=0.0.0.0
SDN_CONTROLLER_PORT=6653
SDN_POLL_INTERVAL_MS=500

# ─── Model ───────────────────────────────────────────────────────────────────
MODEL_ARTIFACTS_DIR=model/artifacts
DETECTION_THRESHOLD=0.70

# ─── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_DIR=logs

# ─── Security ────────────────────────────────────────────────────────────────
# Set to 1 in production to enable HTTPS/mTLS enforcement
ENFORCE_TLS=0
# SHAP values must NOT be exposed publicly — set endpoint to internal only
SHAP_ENDPOINT_INTERNAL_ONLY=1

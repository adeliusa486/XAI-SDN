\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textcolor {red}{Conceptual distribution of Source IP Entropy ($H_{\mathrm  {src}}$). Benign traffic typically exhibits high entropy due to diverse source IP distributions in enterprise networks. Volumetric DDoS attacks, characterized by massive botnet concentration or spoofed subnets, exhibit a sharp density spike at near-zero entropy. This stark distributional divergence makes rolling entropy a highly discriminative feature prior to classifier ingestion.}}}{5}{figure.3}\protected@file@percent }
\newlabel{fig:entropy_dist}{{3}{5}{\textcolor {red}{Conceptual distribution of Source IP Entropy ($H_{\mathrm {src}}$). Benign traffic typically exhibits high entropy due to diverse source IP distributions in enterprise networks. Volumetric DDoS attacks, characterized by massive botnet concentration or spoofed subnets, exhibit a sharp density spike at near-zero entropy. This stark distributional divergence makes rolling entropy a highly discriminative feature prior to classifier ingestion.}}{figure.3}{}}
\newlabel{eq:rolling}{{3}{5}{Entropy feature extraction}{equation.3}{}}
\newlabel{eq:fvec}{{4}{5}{Entropy feature extraction}{equation.4}{}}

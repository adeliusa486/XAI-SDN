\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces  {\fontencoding  {T1}\fontseries  {b}\selectfont  {t}-SNE two-dimensional projection of the 88-dimensional feature space (2,000 representative flows from the CIC-DDoS2019 SYN partition). The two classes---Benign (blue) and DDoS-SYN (amber)---form completely disjoint manifolds, confirming that the combined CICFlowMeter and Shannon entropy feature set is highly separable in this 2D projection, consistent with the near-perfect classification performance reported in Section~\ref {sec:results, though t-SNE separability is not equivalent to linear separability in the original 88-dimensional space.}}}}{15}{figure.6}\protected@file@percent }
\newlabel{fig:tsne}{{6}{15}{\textbf {t-SNE two-dimensional projection of the 88-dimensional feature space (2,000 representative flows from the CIC-DDoS2019 SYN partition). The two classes---Benign (blue) and DDoS-SYN (amber)---form completely disjoint manifolds, confirming that the combined CICFlowMeter and Shannon entropy feature set is highly separable in this 2D projection, consistent with the near-perfect classification performance reported in Section~\ref {sec:results, though t-SNE separability is not equivalent to linear separability in the original 88-dimensional space.}}}{figure.6}{}}
